rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared game content. Published only through the console or Admin SDK.
    // "hidden" is a UI setting, not a confidentiality boundary.
    match /catalog/characters {
      allow get: if true;
      allow list, write: if false;
    }

    // The app stores a user's profile and all of their progress in this one
    // document. No client should be able to access another user's document.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      // Gacha results are written only by the pullCharacters Cloud Function,
      // so the client can't grant itself characters or reset pity.
      allow create: if isOwner(userId) && validUserDocument() &&
                       !request.resource.data.keys().hasAny(serverOwnedFields());
      allow update: if isOwner(userId) && validUserDocument() &&
                       !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(serverOwnedFields());
      // Account deletion cleans this up from the deleteUserData Cloud Function.
      allow delete: if false;
    }

    // Deny all other collections and any future user subcollections until
    // their access model is explicitly defined.
    match /{document=**} {
      allow read, write: if false;
    }

    function serverOwnedFields() {
      return [
        'collection',
        'totalPulls',
        'pityCounter',
        'lastPulledCharacterId',
        'tutorialPullClaimed'
      ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly([
               'displayName',
               'email',
               'provider',
               'lastLoginAt',
               'collection',
               'difficulty',
               'soundEnabled',
               'ambientSoundsEnabled',
               'hapticsEnabled',
               'reminderEnabled',
               'sessionBackgroundEnabled',
               'dailyTargetMinutes',
               'selectedFocusTarget',
               'totalFocusMinutes',
               'bestSessionSeconds',
               'bits',
               'totalPulls',
               'pityCounter',
               'hasCompletedTutorial',
               'themeMode',
               'accentStyle',
               'lastPulledCharacterId',
               'tutorialPullClaimed',
               'sessionHistory',
               'updatedAtClient',
               'updatedAt'
             ]) &&
             validOptionalProfile() &&
             validOptionalProgress();
    }

    function validOptionalProfile() {
      return (!('displayName' in request.resource.data) ||
                (request.resource.data.displayName is string &&
                 request.resource.data.displayName.size() <= 80)) &&
             (!('email' in request.resource.data) ||
                (request.resource.data.email is string &&
                 request.resource.data.email.size() <= 320)) &&
             (!('provider' in request.resource.data) ||
                request.resource.data.provider == 'password') &&
             (!('lastLoginAt' in request.resource.data) ||
                request.resource.data.lastLoginAt is timestamp);
    }

    function validOptionalProgress() {
      return (!('collection' in request.resource.data) ||
                request.resource.data.collection is map) &&
             (!('difficulty' in request.resource.data) ||
                request.resource.data.difficulty in [
                  'elementary', 'middle', 'highSchool', 'college'
                ]) &&
             validOptionalBoolean('soundEnabled') &&
             validOptionalBoolean('ambientSoundsEnabled') &&
             validOptionalBoolean('hapticsEnabled') &&
             validOptionalBoolean('reminderEnabled') &&
             validOptionalBoolean('sessionBackgroundEnabled') &&
             validOptionalNonNegativeInt('dailyTargetMinutes') &&
             validOptionalNonNegativeInt('selectedFocusTarget') &&
             validOptionalNonNegativeInt('totalFocusMinutes') &&
             validOptionalNonNegativeInt('bestSessionSeconds') &&
             validOptionalNonNegativeInt('bits') &&
             validOptionalNonNegativeInt('totalPulls') &&
             validOptionalNonNegativeInt('pityCounter') &&
             validOptionalBoolean('hasCompletedTutorial') &&
             validOptionalBoolean('tutorialPullClaimed') &&
             (!('themeMode' in request.resource.data) ||
                request.resource.data.themeMode in ['system', 'light', 'dark']) &&
             (!('accentStyle' in request.resource.data) ||
                request.resource.data.accentStyle in [
                  'mint', 'sunflower', 'sky', 'rose'
                ]) &&
             // The app writes null until the first character is pulled.
             (!('lastPulledCharacterId' in request.resource.data) ||
                request.resource.data.lastPulledCharacterId == null ||
                (request.resource.data.lastPulledCharacterId is string &&
                 request.resource.data.lastPulledCharacterId.size() <= 80)) &&
             (!('sessionHistory' in request.resource.data) ||
                (request.resource.data.sessionHistory is list &&
                 request.resource.data.sessionHistory.size() <= 120)) &&
             validOptionalNonNegativeInt('updatedAtClient') &&
             (!('updatedAt' in request.resource.data) ||
                request.resource.data.updatedAt is timestamp);
    }

    function validOptionalBoolean(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] is bool;
    }

    function validOptionalNonNegativeInt(field) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is int &&
              request.resource.data[field] >= 0);
    }
  }
}
